FROM node:24-alpine

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_NEWS_SERVICE_URL
ARG NEXT_PUBLIC_STATS_SERVICE_URL
ARG NEXT_PUBLIC_AUTH_SERVICE_URL
ENV NEXT_PUBLIC_NEWS_SERVICE_URL=$NEXT_PUBLIC_NEWS_SERVICE_URL
ENV NEXT_PUBLIC_STATS_SERVICE_URL=$NEXT_PUBLIC_STATS_SERVICE_URL
ENV NEXT_PUBLIC_AUTH_SERVICE_URL=$NEXT_PUBLIC_AUTH_SERVICE_URL

RUN npm run build

CMD ["npm", "run", "start"]